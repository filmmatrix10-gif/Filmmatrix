# Supabase project URL (Project Settings -> API -> Project URL)
VITE_SUPABASE_URL=

# Supabase PUBLISHABLE (anon) key ONLY. Starts with "sb_publishable_" (new key
# format) or is the legacy "anon" JWT. NEVER put the secret/service-role key
# here - that key (prefixed "sb_secret_" or called "service_role") must never
# ship inside the Chrome Extension.
VITE_SUPABASE_PUBLISHABLE_KEY=
